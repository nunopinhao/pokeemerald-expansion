mapscripts FlintTown_MapScripts {}

script FlintTown_EventScript_GymGuard{
    lock
    faceplayer
    msgbox(FlintTown_GymGuardText)
    waitmessage
    release
    end
}

text FlintTown_GymGuardText{
    "Sorry, the Gym is closed for an auction\n"
    "to fund the new League.\p"
    "You look too broke to be able to\n"
    "participate, anyway.\n"
}