mapscripts Route04_MapScripts {}


script Route04_EventScript_CarrieAndAnnabelle{
	trainerbattle_double(TRAINER_CARI_AND_BEL, CarrieAndAnnabelleIntro, CarrieAndAnnabelleOutro, CarrieAndAnnabelleNotEnoughMons)
    msgbox(CarrieAndAnnabellePostBattle, MSGBOX_DEFAULT)
    release 
    end
}

text CarrieAndAnnabelleIntro{
	"We were supposed to be triplets, but we\n"
    "ate our sibling in the womb…\p"
    "Wanna be our friend? {FONT_SMALL_NARROW}evil giggle\n"
}

text CarrieAndAnnabelleOutro{
	"We will find you one day, and kill you…\n"
}

text CarrieAndAnnabellePostBattle{
	"Our parents were scared of us, so we set\n"
    "the house on fire. Now they smell like\l"
    "burned popcorn! {FONT_SMALL_NARROW}evil giggle\n"
}

text CarrieAndAnnabelleNotEnoughMons{
	"Aww, you only have one Pokemon?\n"
    "We can’t play together then…\n"
}

script Route04_EventScript_MargaritaBattle{
	trainerbattle_single(TRAINER_MARGARITA, Margarita_Intro, Margarita_Outro)
    msgbox(Margarita_PostBattle, MSGBOX_AUTOCLOSE) 
    end
 
}

text Margarita_Intro{
	"Those two little girls are messed up.\n"
    "They even speak at the same time!\p"
    "I bet it’s from all the brain-rot\n"
    "kids watch these days!\n"

}

text Margarita_Outro{
	"You’re a scary one, too.\n"
}

text Margarita_PostBattle{
	"I want to call the police on those two\n"
    "evil spawns, but what if they come\l"
    "after me?!\p"
    "… No, I’m not scared of them! SHUT UP!\n"
}

script Route04_EventScript_PedroBattle{
	trainerbattle_single(TRAINER_PEDRO, Pedro_Intro, Pedro_Outro)
    msgbox(Pedro_PostBattle, MSGBOX_AUTOCLOSE) 
    end
 
}
    
text Pedro_Intro{
	"I sold all my Pokemon cards to afford\n"
    "Poke Balls. I got a perfect team.\l"
    "Behold!\n"

}

text Pedro_Outro{
	"So that was a bad investment."
}

text Pedro_PostBattle{
	"I’m going to stick to collecting Pokemon\n"
    "cards. Screw battling!\n"
}

script Route04_EventScript_TeresaBattle{
	trainerbattle_single(TRAINER_TERESA, Teresa_Intro, Teresa_Outro)
    msgbox(Teresa_PostBattle, MSGBOX_AUTOCLOSE) 
    end
 
}
    
text Teresa_Intro{
	"Team Blaze stole one of my Pokemon,\n"
    "spat on my face, and took my money.\n"

}

text Teresa_Outro{
	"And now you’ll take my money too…"
}

text Teresa_PostBattle{
	"I’m one bad day away from alcoholism.\n"
}

script Route04_EventScript_FrancisBattle{
	trainerbattle_single(TRAINER_FRANCIS, Francis_Intro, Francis_Outro)
    msgbox(Francis_PostBattle, MSGBOX_AUTOCLOSE) 
    end
 
}
    
text Francis_Intro{
	"There hasn’t been a new Champion in\n"
    "centuries because it was prohibited.\p"
    "I will be the new first Champion!\n"

}

text Francis_Outro{
	"Arceus damn it!\n"
}

text Francis_PostBattle{
	"This is not the end for me.\n"
    "Back to training!\n"
}

script Route04_EventScript_Sign{
    msgbox(Route04_Text_Sign, MSGBOX_SIGN)
    end
}

text Route04_Text_Sign{
    "{UP_ARROW} BIGTHORN VILLAGE\n"
    "{RIGHT_ARROW} NEWVILLA TOWN\p"
    "{LEFT_ARROW} FLINT TOWN\n"
}

script Route04_EventScript_LeenaScene1{
    lock
    applymovement(11, LeenaMoveNearPlayer1)
    waitmovement(0)
    msgbox(Leena_Text)
    waitmessage
    setvar(VAR_ROUTE4_LEENA, 1)
    setflag(FLAG_THICKET_FOREST_BLAISE_FIGHT)
    release
    end
}
movement LeenaMoveNearPlayer1{
    walk_down
    walk_left 

}
script Route04_EventScript_LeenaScene2{
    lock
    applymovement(11, LeenaMoveNearPlayer2)
    waitmovement(0)
    msgbox(Leena_Text)
    waitmessage
    setvar(VAR_ROUTE4_LEENA, 1)
    setflag(FLAG_THICKET_FOREST_BLAISE_FIGHT)
    release
    end
}
movement LeenaMoveNearPlayer2{
    walk_down *2
    walk_left 
}
script Route04_EventScript_LeenaScene3{
    lock
    applymovement(11, LeenaMoveNearPlayer3)
    waitmovement(0)
    msgbox(Leena_Text)
    waitmessage
    setvar(VAR_ROUTE4_LEENA, 1)
    setflag(FLAG_THICKET_FOREST_BLAISE_FIGHT)
    release
    end
}
movement LeenaMoveNearPlayer3{
    walk_down *3
    walk_left 
}
text Leena_Text{
    "{COLOR RED}{SHADOW LIGHT_RED}Leena: {COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Oh, {PLAYER}!\n"
    "Thank goodness you came! Some Team Blaze\l"
    "bozos stole my little darlings!\p"
    "Can you please help?\n"
    "They ran into the woods {FONT_SMALL_NARROWER}sniff sniff\n"
}


script Route04_EventScript_LeenaAfterScene{
    lock
    msgbox(LeenaAfterScene_Text)
    waitmessage
    release
    end
}   

text LeenaAfterScene_Text{
    "{COLOR RED}{SHADOW LIGHT_RED}Leena: {COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}I saw them heading for the\n"
    "Thicket Woods! Those dirty criminals!\l"
    "{FONT_SMALL_NARROWER}sniff sniff\n"
}
