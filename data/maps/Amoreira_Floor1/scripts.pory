    waitmovement(0)
    call(Amoreira_Floor1_EventScript_StartSpeech)
    releaseall
    end
}

script Amoreira_Floor1_EventScript_StartSpeech{
    applymovement(1, Common_Movement_FaceRight)
	waitmovement(0)
    msgbox(StartSceneText1)
    waitmessage
    applymovement(1, Common_Movement_FaceLeft)
	waitmovement(0)
    msgbox(StartSceneText2)
    waitmessage
    applymovement(1, Common_Movement_FaceRight)
	waitmovement(0)
    msgbox(StartSceneText3)
    waitmessage
    setvar(VAR_AMOREIRA_START, 1)
    setflag(FLAG_SYS_B_DASH)
}

script Amoreira_Floor1_Grandma_HealSpot{
    if(flag(FLAG_ADVENTURE_STARTED)){
        lock
        faceplayer
        msgbox(GrandmaDefeatedZoruaText2)
        waitmessage
        release
        end
    }
    elif(flag(FLAG_DEFEATED_ZORUA)){
        lock
        faceplayer
        msgbox(GrandmaDefeatedZoruaText)
        waitmessage
        playfanfare(MUS_OBTAIN_ITEM)
	    message("{PLAYER} received the POKéDEX!$")
	    waitfanfare
        closemessage
	    setflag(FLAG_SYS_POKEDEX_GET)
        setflag(FLAG_ADVENTURE_STARTED)
	    special(SetUnlockedPokedexFlags)
	    setflag(FLAG_RECEIVED_POKEDEX_FROM_BIRCH)
	    setvar(VAR_CABLE_CLUB_TUTORIAL_STATE, 1)
        setvar(VAR_MADELEINE_READY_FOR_BATTLE, 1)
        setflag(FLAG_TRUCK_AMOREIRA)
        setflag(FLAG_MR_FALLSMELL)
        msgbox(GrandmaDefeatedZoruaText2)
        waitmessage
        release
        end
    }
    else{
        lock
        faceplayer
        msgbox(GrandmaHealSpotText)
        waitmessage
        release
        end
    }
}



movement PlayerMoveNearGrandma1 {
    walk_down *3 
}

movement PlayerMoveNearGrandma2 {
	walk_left
    walk_down *2 
}

movement PlayerMoveNearGrandma3 {
    walk_down *2
    walk_left *2
    walk_down
}

movement PlayerMoveRivalBattle1 {
    walk_left *3
    walk_down *2
}
movement PlayerMoveRivalBattle2 {
    walk_left *4
    walk_down 
}
movement PlayerMoveRivalBattle3 {
    walk_left *5
    walk_down *2
}
movement PlayerMoveRivalBattle4 {
    walk_down *3
}
movement PlayerMoveRivalBattle5 {
    walk_left 
    walk_down *3
}
movement PlayerMoveRivalBattle6 {
    walk_left *2
    walk_down *3
}

movement AndrewMoveBattle {
    walk_up 
    walk_right *4
}
movement AdrianMoveBattle {
    walk_left
    walk_up *2
    walk_right *5
}

movement AndrewLeave {
    walk_left *4
    walk_down
    face_right
}

movement GrandmaMoveHeal {
    walk_right *2
    face_up
}

movement GrandmaReturnAfterHeal {
    walk_left *2
    face_right
}





text FirstBattleOver{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} And the winner of the first\n"
    "round is {PLAYER}!\p"
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Adrian:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} What are you, a sports\n"
    "announcer?\p"
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} If you don’t take this\n"
    "championship seriously, you won’t get\l"
    "the prize!\p"
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Andrew:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} No carrot cake for me then. But\n"
    "the fight was still cool, I guess.\n"
}

text SecondBattleSetUp{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} You are too nonchalant\n"
    "sometimes Andrew. Where is your fiery\l"
    "spirit?\p"
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Here {PLAYER}, let me heal your\n"
    "pokemon.\n"
}

text StartSceneText1{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Ah, there you are {PLAYER}!\p"
    "About time you crawl out of bed,\n"
    "you lazy bum.\p"
    "I have been up since the crack of dawn\n"
    "doing chores.\p"
    "Your cousins are already here having\n"
    "lunch!\p"
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Andrew:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Come on Grandma, {PLAYER} has\n"
    "just got out of bed and you are already\l"
    "nagging them.\p" 
    "Can you pass me the fries, Adrian?\p"
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Adrian:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} {PLAYER} was probably up all\n"
    "night playing Crash Royale.\p"
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Andrew:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} That was you, idiot.\p"
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Good thing I have a mission for\n"
    "{PLAYER} today, that oughta teach you\l"
    "some responsibility!\p"
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Andrew:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} It better not be moving new\n"
    "stuff into the house. Speaking of which,\l"
    "you know what this house really needs?\p"
    "More furniture!\p"
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Adrian:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Yeah, I was thinking it’s still\n"
    "too easy to move around. It could really\l"
    "get more claustrophobic in here.\n"
}

text StartSceneText2{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Yes boys, make fun of your\n"
    "hoarding Grandma.\p"
    "If there ever is a fire in your house,\n"
    "don’t come crawling to me about\l"
    "extra furniture.\p"
    "Look at my new armoire, isn’t it a\n"
    "beauty? Got it on the side of the road.\p"
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Andrew:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Getting a little off topic here.\n"
    "So what do you need {PLAYER} to do\l"
    "Grandma?\p"
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} A naughty pokemon has been\n"
    "messing with my Torchic, attacking them\l"
    "and eating all my eggs!\p"
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Adrian:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} That explains why there is so\n"
    "little omelet for lunch today.\n"
}

text StartSceneText3{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} {PLAYER}, I want you to\n"
    "investigate and chase off any egg-eating\l" 
    "Pokemon off my darling eggs.\p" 
    "Go to the backyard and take a look.\n" 
    "You might find something there to help\l"
    "you out.\p"
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Andrew:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Good luck playing detective,\n"
    "{PLAYER}. The stakes are very high.\n"
}

text GrandmaSpeechText{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} The backyard is through the door\n"
    "on the right, but it’s not like you need\l"
    "directions in your own home, right?\n"   
}

text AndrewSpeechText{
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Andrew:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Our Mom sent us on a weird\n"
    "errand this morning as well.\p"
    "I wonder if it’s related to your own\n"
    "errand? Those two ladies are both acting\l"
    "suspiciously.\n"
}

text AdrianSpeechText{
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Adrian:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Andrew and I got our own POKEMON\n"
    "this morning.\n"
}

text CantLeaveText{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} {PLAYER}, are you still asleep,\n"
    "dummy? The backyard door is on the\l"
    "right.\n"
}

text GrandmaStarterSpeechFroakie{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} So you chose Froakie?\n"
    "Of course you did! A grandchild of mine\l"
    "could only have good taste.\n"
}

text GrandmaStarterSpeechRowlet{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} So you chose Rowlet?\n"
    "Of course you did! A grandchild of mine\l"
    "could only have good taste.\n"
}

text GrandmaStarterSpeechTorchic{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} So you chose Torchic?\n"
    "Of course you did! A grandchild of mine\l"
    "could only have good taste.\n"
}

text RivalBattleSpeechText{
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Andrew:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Except you don’t have good taste.\n"
    "You go shopping at the junkyard.\p"
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Zip it now, other grandchild!\n"
    "Don’t bite the hand that feeds you\l"
    "schmucks every day.\p"
    "Now, the second part of the errand is\n"
    "here. A very exciting one!\p"
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Adrian:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Which is?\p"
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Duke it out, fellas. Granny\n"
    "wants to see some action! Winner gets a\l"
    "slice of carrot cake.\n"
}

text Andrew_Intro{
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Andrew:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Well, you heard the old lady.\n"
    "I’m first!\n"
}
 
text Andrew_Outro{
    "Like they say, hard situations aren’t\n"
    "easy.\n"
}

text Adrian_Intro{
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Adrian:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Speaking of cake, battling\n"
    "against a type you are strong against is\l" 
    "a cakewalk.\p"
    "I’m next little cousin, and you can bet\n"
    "I won’t hold back.\n"
}
 
text Adrian_Outro{
    "Didn't see this coming..."
}

text RivalBattlesOver{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Power to the new gen of Pokemon\n"
    "trainers!\p"
    "Seems like your little cousin has won by\n"
    "a landslide.\p"
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Andrew:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} {PLAYER} is not younger by that\n"
    "much.\p"
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Here is your reward, hon.\n"
    "To the first champion of Mulbery Town!\n"
}

text Grandma_GiveGateau{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} What is that look? I didn’t lie,\n"
    "it IS carrot cake. It’s just a bit old,\l"
    "is all. Don’t be petty.\n"
}

text GrandmaHealSpotText{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Grandma is rooting for you!\n"
}

text Grandma_GivePokeBalls{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} And here is the rest of your\n"
    "prize.\n"
}

text Grandma_ExplainPokeBalls{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Anyhow, your new partner can\n"
    "help you find who has been intruding in\l"
    "my garden.\p"
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Andrew:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} It's your turn to go on a weird\n"
    "errand, it seems.\p"
    "We can play Crash Royale later when\n"
    "you're done!\p"
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Adrian:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Don’t encourage {PLAYER} to waste\n" 
    "away on mobile games. Besides, we all\l"
    "know who is the real pro at that game.\p"
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} And this is my legacy, three\n"
    "little gamers. I’m writing you all out\l"
    "of my will.\n"
}

text AndrewSpeechAfterBattleText{
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Andrew:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Grandma is being unfair.\n"
    "We don’t JUST play mobile games.\l"
    "We also play on PC!\n"
}

text AdrianSpeechAfterBattleText{
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Adrian:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Why do I get the sneaking\n"
    "suspicion there’s more to these errands\l"
    "than meets the eye.\n"
}

text GrandmaDefeatedZoruaText{
    "{COLOR RED}{SHADOW LIGHT_RED}Grandma:{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} Here is my little hero!\n"
    "Your cousins already left.\p"
    "My Torchic and eggs thank you, hon.\n"
    "Well you’re no turnip, so you must know\l"
    "there is something else going on.\p"
    "My old friends and I decided to revive\n"
    "the League System!\p"
    "It was once abolished after a terrible\n"
    "catastrophe. But we need it back pronto.\p"
    "RAMTO’s first Gym Leaders in centuries\n"
    "have been chosen already.\p"
    "{PLAYER}, go out there and challenge\n"
    "them! There is so much I need to tell\l"
    "you, but it will come in due time.\p"
    "Take this with you.\n"
}

text GrandmaDefeatedZoruaText2{
    "RAMTO needs you youngsters. Make this\n"
    "old lady proud!\n"
}
